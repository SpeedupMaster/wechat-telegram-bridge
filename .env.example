# 复制为 .env 后填写（或者直接运行 ./setup.sh，它会问你这几项）。.env 含密钥，不要提交到 git。

# 在 https://my.telegram.org → API development tools 申请
TG_API_ID=
TG_API_HASH=
# 找 @BotFather 发 /newbot 创建机器人得到
TG_BOT_TOKEN=

# 可选：连 Telegram 用的代理（海外 VPS 留空），例如 socks5://127.0.0.1:7890
TG_PROXY=

# 使用方式（改完执行 docker compose up -d --no-deps telegram-bridge 生效）：
#   groups = 每个微信会话一个 Telegram 群，由你的 Telegram 账号自动建群（默认）
#   topics = 一个开启了「话题」的群，每个微信会话一个话题，只用机器人，不登录你的账号
BRIDGE_MODE=groups
# 可选，仅 topics 模式：话题群 ID（-100 开头）。留空则在群里发 /forum 指定
TG_FORUM_CHAT=
# 可选：是否桥接公众号/服务号消息（默认 true）
# BRIDGE_OFFICIAL_ACCOUNTS=true
# 可选：将公众号/服务号单独收进指定话题群（-100 开头，每个公众号一个独立话题）；留空也可在话题群里发 /oaforum 指定
# TG_OA_FORUM_CHAT=
# 可选：在 Telegram 里接听微信语音通话（Mini App 网页）。填公网 HTTPS 地址后启用，
# 并用 Caddy/nginx 或 Cloudflare Tunnel 把它转到本机 127.0.0.1:8780（见 README「在 Telegram 接听微信通话」）
CALL_WEB_URL=
# 可选：用 Cloudflare Tunnel 代替 Caddy/nginx 时取消下面两行注释，填入隧道 token
# COMPOSE_PROFILES=cloudflare
# CF_TUNNEL_TOKEN=
# 可选：通话页面监听地址，默认 127.0.0.1:8780
# CALL_WEB_LISTEN=127.0.0.1:8780
# 可选：在 @BotFather 用 /newapp 创建的 Mini App 短名称；填了以后「接听」按钮以 Mini App 方式打开
# CALL_WEB_APP=
# 可选：将 Telegram 发送的常见 Emoji 反向转为微信自带小黄脸代码（如 😁 → [呲牙]、🤦 → [捂脸]、🫡 → [社会社会]，默认 false）
# EMOJI_TO_WECHAT=false
# 可选：微信掉线后自动尝试重新登录一次（默认 false；需先在手机微信开启「自动登录该设备」，
# 开启后会在随机延迟后仅尝试一次，失败则提醒手动登录，并内置冷却期防风控）
# AUTO_RELOGIN=false
# 可选：agent-wechat 镜像版本
# AGENT_WECHAT_VERSION=latest
